        fn foo<'life0, 'dynosaur>(&'life0 self)
            ->
                _Pin<_Box<dyn ::core::future::Future<Output = i32> +
                'dynosaur>> where 'life0: 'dynosaur, Self: 'dynosaur {
            _Box::pin(<Self as Foo>::foo(self))
