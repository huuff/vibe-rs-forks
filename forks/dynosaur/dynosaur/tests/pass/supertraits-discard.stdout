use dynosaur::dynosaur;

// `#[dynosaur(_)]` registers a trait as a possible supertrait without
// generating a `Dyn*` type for it. It composes transitively.
trait Base {
    fn base(&self)
    -> i32;
}
#[doc =
"Internal: carries the definition of [`Base`] so it can be a supertrait of another `#[dynosaur]` trait."]
#[doc(hidden)]
macro_rules! __dynosaur_Base {
    ($ ($rest : tt) *) =>
    {
        :: dynosaur :: __resolve_supertraits!
        { $ ($rest) * supertrait { trait Base { fn base(& self) -> i32; } } }
    };
}
#[doc(hidden)]
use __dynosaur_Base;

trait Bar: Base {
    fn bar(&self)
    -> i32;
}
#[doc =
"Internal: carries the definition of [`Bar`] so it can be a supertrait of another `#[dynosaur]` trait."]
#[doc(hidden)]
macro_rules! __dynosaur_Bar {
    ($ ($rest : tt) *) =>
    {
        :: dynosaur :: __resolve_supertraits!
        {
            $ ($rest) * supertrait
            { trait Bar : Base { fn bar(& self) -> i32; } } supertrait
            { trait Base { fn base(& self) -> i32; } }
        }
    };
}
#[doc(hidden)]
use __dynosaur_Bar;

trait Foo: Bar {
    async fn foo(&self)
    -> i32;
}
#[doc =
"Internal: carries the definition of [`Foo`] so it can be a supertrait of another `#[dynosaur]` trait."]
#[doc(hidden)]
macro_rules! __dynosaur_Foo {
    ($ ($rest : tt) *) =>
    {
        :: dynosaur :: __resolve_supertraits!
        {
            $ ($rest) * supertrait
            { trait Foo : Bar { async fn foo(& self) -> i32; } } supertrait
            { trait Bar : Base { fn bar(& self) -> i32; } } supertrait
            { trait Base { fn base(& self) -> i32; } }
        }
    };
}
#[doc(hidden)]
use __dynosaur_Foo;
