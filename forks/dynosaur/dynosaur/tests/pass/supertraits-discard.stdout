    impl<DYNOSAUR: Foo> Foo for &DYNOSAUR where DYNOSAUR: ?Sized, Self: Bar {
        fn foo(&self) -> impl ::core::future::Future<Output = i32> {
            <DYNOSAUR as Foo>::foo(self)
