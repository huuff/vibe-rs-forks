struct S;

impl base::Qux for S {
    fn qux(&self, x: i32) -> i32 { x }
}

impl base::Bar for S {
    async fn bar(&self, x: i32, _: u8) -> i32 { x + 1 }
}

impl by_path::Foo for S {
    async fn foo(&self) -> i32 { 3 }
}

impl by_import::Foo for S {
    fn foo(&self) -> impl Iterator<Item = i32> { std::iter::once(4) }
}

async fn use_dyn(a: Box<by_path::DynFoo<'_>>, b: &by_import::DynFoo<'_>)
    -> i32 {
    use base::{Bar, Qux};
    use by_path::Foo as _;
    use by_import::Foo as _;
    a.qux(1) + a.bar(1, 0).await + a.foo().await + b.qux(1) +
        b.foo().sum::<i32>()
}

fn is_send<T: Send>(_: &T) {}

fn main() {
    let s = S;
    let a = by_path::DynFoo::new_box(S);
    is_send(&a);
    let _ = use_dyn(a, by_import::DynFoo::from_ref(&s));
}
