#![feature(prelude_import)]
extern crate std;
#[prelude_import]
use std::prelude::rust_2021::*;
use dynosaur::dynosaur;

// `Bar` has methods but no `#[dynosaur]` attribute, so `Foo` cannot learn
// them: the generated `__dynosaur_Bar!` call has nothing to resolve to.
trait Bar {
    fn bar(&self)
    -> i32;
}


fn main() {}
